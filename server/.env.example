# Active Provider: 'tabi' (primary) with automatic Groq failover
MODEL_PROVIDER=tabi

# Google Stitch
STITCH_API_KEY=your_stitch_api_key_here

# Server
PORT=3001

# Tabi AI Configuration
TABI_API_KEY=your_tabi_api_key_here
TABI_BASE_URL=https://tabitoken.com/v1

# Tabi Specialist Models
TABI_BA_MODEL=claude-opus-5
TABI_PM_MODEL=claude-opus-5
TABI_DESIGNER_MODEL=claude-opus-5-thinking
TABI_ARCHITECT_MODEL=claude-opus-5-thinking
TABI_ENGINEER_MODEL=claude-opus-5-thinking
TABI_CODE_REVIEW_MODEL=claude-opus-5-thinking
TABI_QA_MODEL=claude-opus-5-thinking

# Secondary Fallback Provider: Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BA_MODEL=qwen/qwen3.8-27b
GROQ_PM_MODEL=qwen/qwen3.8-27b
GROQ_DESIGNER_MODEL=qwen/qwen3.8-27b
GROQ_ARCHITECT_MODEL=qwen/qwen3.8-27b
GROQ_ENGINEER_MODEL=qwen/qwen3.8-27b
GROQ_CODE_REVIEW_MODEL=qwen/qwen3.8-27b
GROQ_QA_MODEL=qwen/qwen3.8-27b

# Database
DATABASE_URL=postgresql://taydau:taydau@localhost:5432/taydau

# Budget
BUDGET_HARD_LIMIT_USD=10.00

# Pricing definitions per 1M tokens
PRICING_CLAUDE_OPUS_5_INPUT=15.00
PRICING_CLAUDE_OPUS_5_OUTPUT=75.00
PRICING_CLAUDE_OPUS_5_THINKING_INPUT=15.00
PRICING_CLAUDE_OPUS_5_THINKING_OUTPUT=75.00
PRICING_QWEN_QWEN3_8_27B_INPUT=0.80
PRICING_QWEN_QWEN3_8_27B_OUTPUT=4.00
