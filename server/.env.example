# Provider selection: 'groq' or 'alibaba' (legacy alias: 'qwen')
MODEL_PROVIDER=alibaba

# Alibaba Cloud Model Studio (fill in your own credentials)
ALIBABA_API_KEY=your_alibaba_api_key_here
ALIBABA_BASE_URL=https://your-region.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_WORKSPACE_ID=your_workspace_id_here

# Model IDs (check your Model Studio account for available models)
QWEN_BA_MODEL=qwen-plus
QWEN_PM_MODEL=qwen-plus
QWEN_ARCHITECT_MODEL=qwen-max
QWEN_ENGINEER_MODEL=qwen-max
QWEN_QA_MODEL=qwen-plus

# Database
DATABASE_URL=postgresql://taydau:taydau@localhost:5432/taydau

# Pricing per 1M tokens (config-driven)
PRICING_QWEN_PLUS_INPUT=0.8
PRICING_QWEN_PLUS_OUTPUT=2.0
PRICING_QWEN_MAX_INPUT=2.0
PRICING_QWEN_MAX_OUTPUT=6.0
PRICING_QWEN_TURBO_INPUT=0.3
PRICING_QWEN_TURBO_OUTPUT=0.6

# Budget
BUDGET_HARD_LIMIT_USD=5.00

# Server
PORT=3001

# Groq Cloud
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_BA_MODEL=qwen/qwen3.8-27b
GROQ_PM_MODEL=openai/gpt-oss-20b
GROQ_ARCHITECT_MODEL=openai/gpt-oss-120b
GROQ_ENGINEER_MODEL=qwen/qwen3.8-27b
GROQ_QA_MODEL=openai/gpt-oss-120b

# Groq pricing (estimated list-price equivalent per 1M tokens, NOT actual free-tier billing)
PRICING_QWEN_QWEN3_8_27B_INPUT=0.80
PRICING_QWEN_QWEN3_8_27B_OUTPUT=4.00
