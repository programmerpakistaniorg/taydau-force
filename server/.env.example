# TayDau Force — Multi-Provider Free-Tier Configuration
INFERENCE_BILLING_MODE=FREE_ONLY
ROUTING_MODE=active
PORT=3001

# ── Primary Free Providers ───────────────────────────────────────────────────
# Google AI Studio (Gemini 2.0 Flash / 1.5 Flash) - 15 RPM Free Tier
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq Cloud (Llama 3.3 70B, GPT-OSS 120B/20B, Qwen 3.8) - Free Developer Tier
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM (Llama 3.3 70B Instruct) - Free Credits Tier
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Mistral AI (Codestral, Mistral Small) - Free Developer Tier
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter (:free model pool) - Community Free Tier
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Database & Platform ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://taydau:taydau@localhost:5432/taydau
BUDGET_HARD_LIMIT_USD=10.00
